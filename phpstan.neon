parameters:
    paths:
        - src

    level: 8

    excludePaths:
        - tests/Mocks

    treatPhpDocTypesAsCertain: false

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Promise generics are documented by PHPDoc where relevant.
        - '#return type .*React\\Promise\\PromiseInterface.*types#'
        - '#has parameter .*React\\Promise\\PromiseInterface#'
        # Factories intentionally use late static binding
        - '#Unsafe usage of new static\(\)#'
