{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./docs/.vitepress/theme/*"]
        }
    },
    "include": [
        "docs/.vitepress/config.mts",
        "playwright.config.ts",
        "tools/browser/**/*.ts",
        "docs/.vitepress/theme/**/*.ts",
        "docs/.vitepress/theme/**/*.vue"
    ]
}
